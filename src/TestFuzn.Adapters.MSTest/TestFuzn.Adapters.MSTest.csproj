<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Fuzn.TestFuzn.Adapters.MSTest</AssemblyName>
    <RootNamespace>Fuzn.TestFuzn</RootNamespace>
    <OutputType>Library</OutputType>
    <PackageId>Fuzn.TestFuzn.Adapters.MSTest</PackageId>
    <Title>Fuzn.TestFuzn.Adapters.MSTest</Title>
    <Description>MSTest plugin for TestFuzn</Description>
    <PackageTags>testing;unit-testing;e2e;load-testing;dotnet;TestFuzn;mstest</PackageTags>
    <Authors>Fuzn</Authors>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TestFuzn\TestFuzn.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Platform" PrivateAssets="all" />
    <PackageReference Include="MSTest.TestFramework" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Build files for the test project. The entry point source compiles there, not here. -->
  <ItemGroup>
    <Compile Remove="buildTransitive\**" />
    <None Include="buildTransitive\Fuzn.TestFuzn.Adapters.MSTest.props" Pack="true" PackagePath="buildTransitive\" />
    <None Include="buildTransitive\Fuzn.TestFuzn.Adapters.MSTest.targets" Pack="true" PackagePath="buildTransitive\" />
    <None Include="buildTransitive\TestFuznEntryPoint.cs" Pack="true" PackagePath="buildTransitive\" />    <None Include="build\Fuzn.TestFuzn.Adapters.MSTest.props" Pack="true" PackagePath="build\" />
    <None Include="build\Fuzn.TestFuzn.Adapters.MSTest.targets" Pack="true" PackagePath="build\" />
  </ItemGroup>

</Project>
